{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "types": ["node"],

    "allowSyntheticDefaultImports": true,

    "noEmit": false
  },
  "include": [
    "src"
  ]
}