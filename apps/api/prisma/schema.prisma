generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  ACTIVE
 ARCHIVED
  COMPLETED
}

enum ProjectVisibility {
  PRIVATE
  TEAM
  PUBLIC
}

enum RepositoryProvider {
  LOCAL
  GITHUB
  ZIP
}

enum RepositoryStatus {
  ACTIVE
  INDEXING
  INDEXED
  FAILED
  ARCHIVED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RepairJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingStatus {
  OPEN
  REVIEWED
  PATCHED
  VALIDATED
  REJECTED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum PatchLifecycle {
  DETECTED
  REVIEWED
  PATCH_GENERATED
  PATCH_APPLIED_IN_WORKSPACE
  TESTS_RERAN
  VALIDATED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  preferences  Json     @default("{}")

  // Relations
  projects     Project[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id           String            @id @default(cuid())

  name         String
  description  String?

  status       ProjectStatus     @default(ACTIVE)
  visibility   ProjectVisibility @default(PRIVATE)

  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  repositories Repository[]
  analyses    AnalysisRun[]
  repairJobs  RepairJob[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
}

model Repository {
  id              String               @id @default(cuid())

  name            String
  description     String?

  provider        RepositoryProvider   @default(LOCAL)
  status          RepositoryStatus     @default(ACTIVE)

  // Remote repository URL (GitHub, GitLab, etc.)
  url             String?

  // Local indexed repository location
  workspacePath   String?

  defaultBranch   String?
  isPrivate       Boolean              @default(false)

  projectId       String
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  files           RepositoryFile[]
  embeddings      RepositoryEmbedding[]
  analyses        AnalysisRun[]
  repairJobs      RepairJob[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([projectId])
  @@index([provider])
  @@index([status])
  @@index([workspacePath])

  @@map("repositories")
}

model RepositoryFile {
  id            String      @id @default(cuid())

  repositoryId  String
  repository    Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  name          String
  path          String
  type          String

  parentPath    String?
  content       String?

  embeddings    RepositoryEmbedding[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([repositoryId])
  @@index([path])
  @@index([parentPath])

  @@map("repository_files")
}

model RepositoryEmbedding {
  id               String @id @default(cuid())

  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  repositoryFileId String?
  repositoryFile   RepositoryFile? @relation(fields: [repositoryFileId], references: [id], onDelete: Cascade)

  filePath         String

  chunkIndex       Int
  content          String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([repositoryId])
  @@index([repositoryFileId])
  @@index([filePath])

  @@map("repository_embeddings")
}

model AnalysisRun {
  id              String         @id @default(cuid())
  projectId       String
  repositoryId    String
  ref             String         @default("HEAD")
  status          AnalysisStatus @default(PENDING)
  progress        Int            @default(0)
  totalStages     Int            @default(0)
  completedStages Int            @default(0)
  tools           Json           @default("[]")
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  currentStage    String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository      Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  toolExecutions  ToolExecution[]
  events          AnalysisEvent[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@index([repositoryId])
  @@index([status])
  @@map("analysis_runs")
}

model ToolExecution {
  id           String         @id @default(cuid())
  analysisRunId String
  command      String
  args         Json
  status       String
  exitCode     Int?
  stdout       String         @default("")
  stderr       String         @default("")
  durationMs   Int            @default(0)
  evidence     Json           @default("[]")
  createdAt    DateTime       @default(now())

  analysisRun  AnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@index([status])
  @@map("tool_executions")
}

model AnalysisEvent {
  id           String      @id @default(cuid())
  analysisRunId String
  type         String
  stage        String?
  message      String?
  progress     Int?
  createdAt    DateTime    @default(now())

  analysisRun  AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId, createdAt])
  @@index([type])
  @@map("analysis_events")
}

model RepairJob {
  id           String         @id @default(cuid())
  projectId    String
  repositoryId String
  ref          String         @default("HEAD")
  status       RepairJobStatus @default(PENDING)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings     Finding[]
  patches      Patch[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId])
  @@index([repositoryId])
  @@index([status])
}

model Finding {
  id             String         @id @default(cuid())
  repairJobId    String
  category       String
  severity       FindingSeverity
  confidence     Float
  title          String
  description    String
  evidence       Json           @default("[]")
  filePath       String
  startLine      Int?
  endLine        Int?
  detectionSource String
  recommendedFix String?
  status         FindingStatus  @default(OPEN)
  patchId        String?        @unique
  repairJob      RepairJob      @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  patch          Patch?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([repairJobId])
  @@index([status])
  @@index([severity])
}

model Patch {
  id             String         @id @default(cuid())
  findingId      String         @unique
  repairJobId    String
  diffContent    String
  diffHash       String
  patchBytes     Int
  linesAdded     Int
  linesRemoved   Int
  riskScore      Float
  target         String
  lifecycle      PatchLifecycle @default(PATCH_GENERATED)
  finding        Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  repairJob      RepairJob      @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  validations    Validation[]
  applications   PatchApplication[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appliedAt      DateTime?
  validatedAt    DateTime?

  @@index([repairJobId])
  @@index([lifecycle])
}

model Validation {
  id                 String   @id @default(cuid())
  patchId            String
  status             String
  testsRun           Int      @default(0)
  testsPassed        Int      @default(0)
  testsFailed        Int      @default(0)
  lintPassed         Boolean  @default(false)
  typeCheckPassed    Boolean  @default(false)
  securityScanPassed Boolean  @default(false)
  failures           Json     @default("[]")
  durationMs         Int      @default(0)
  patch              Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@index([patchId])
}

model PatchApplication {
  id        String   @id @default(cuid())
  patchId   String
  target    String
  success   Boolean
  output    String?
  error     String?
  patch     Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([patchId])
}