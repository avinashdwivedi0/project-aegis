generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  ACTIVE
 ARCHIVED
  COMPLETED
}

enum ProjectVisibility {
  PRIVATE
  TEAM
  PUBLIC
}

enum RepositoryProvider {
  LOCAL
  GITHUB
  ZIP
}

enum RepositoryStatus {
  ACTIVE
  INDEXING
  INDEXED
  FAILED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)

  // Relations
  projects     Project[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id           String            @id @default(cuid())

  name         String
  description  String?

  status       ProjectStatus     @default(ACTIVE)
  visibility   ProjectVisibility @default(PRIVATE)

  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  repositories Repository[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
}

model Repository {
  id              String               @id @default(cuid())

  name            String
  description     String?

  provider        RepositoryProvider   @default(LOCAL)
  status          RepositoryStatus     @default(ACTIVE)

  // Remote repository URL (GitHub, GitLab, etc.)
  url             String?

  // Local indexed repository location
  workspacePath   String?

  defaultBranch   String?
  isPrivate       Boolean              @default(false)

  projectId       String
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  files           RepositoryFile[]
  embeddings      RepositoryEmbedding[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([projectId])
  @@index([provider])
  @@index([status])
  @@index([workspacePath])

  @@map("repositories")
}

model RepositoryFile {
  id            String      @id @default(cuid())

  repositoryId  String
  repository    Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  name          String
  path          String
  type          String

  parentPath    String?

  embeddings    RepositoryEmbedding[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([repositoryId])
  @@index([path])
  @@index([parentPath])

  @@map("repository_files")
}

model RepositoryEmbedding {
  id               String @id @default(cuid())

  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  repositoryFileId String?
  repositoryFile   RepositoryFile? @relation(fields: [repositoryFileId], references: [id], onDelete: Cascade)

  filePath         String

  chunkIndex       Int
  content          String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([repositoryId])
  @@index([repositoryFileId])
  @@index([filePath])

  @@map("repository_embeddings")
}