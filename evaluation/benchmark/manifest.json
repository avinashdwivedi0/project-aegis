      "baselineCommands": ["pnpm run build", "pnpm run lint", "pnpm test"],
      "conditions": "Run with the repository's pinned toolchain and no network access."
    },
    {
      "id": "fixture-node-dependencies",
      "source": "local-fixture",
      "version": "v1",
      "path": "evaluation/benchmark/projects/fixture-node-dependencies",
      "language": "typescript",
      "categories": ["dependency", "tests"],
      "groundTruthFindingIds": ["fixture/vulnerable-package", "fixture/failing-test"],
      "commands": ["pnpm install --frozen-lockfile", "pnpm test"],
      "baselineCommands": ["pnpm test"],
      "conditions": "Run with the repository's pinned toolchain and no network access."
    }
  ],
  "baselines": [
    "deterministic-tools",
    "deterministic-tools-plus-single-model",
